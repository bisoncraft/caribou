--- a/simplybs/pack/build.go
+++ b/simplybs/pack/build.go
@@ -1,7 +1,10 @@
 package pack
 
 import (
+	"crypto/sha256"
+	"encoding/hex"
 	"fmt"
+	"io"
 	"log"
 	"os"
 	"os/exec"
@@ -53,12 +56,47 @@ func (p *Package) ExtractEnv(host *host.Host, envPath string, envNativePath stri
 	writeDotEnv(envPath+"/_source_me", newEnv)
 }
 
+// cachedArchiveIsIntact reports whether a source archive already in the cache
+// hashes to the sha256 its package pins. A run killed mid-transfer leaves a
+// partial file behind, and DownloadSource below reuses whatever is present, so
+// without this check a truncated archive is permanent: nothing re-fetches it
+// and nothing re-checks it.
+func cachedArchiveIsIntact(sourcePath, expectedSha256 string) bool {
+	f, err := os.Open(sourcePath)
+	if err != nil {
+		return false
+	}
+	defer f.Close()
+	hasher := sha256.New()
+	if _, err := io.Copy(hasher, f); err != nil {
+		return false
+	}
+	return hex.EncodeToString(hasher.Sum(nil)) == expectedSha256
+}
