--- a/simplybs/patches/ct-tools/glibc/2.31/0100-intl-plural-yylex-declared.patch
+++ b/simplybs/patches/ct-tools/glibc/2.31/0100-intl-plural-yylex-declared.patch
@@ -0,0 +1,26 @@
+intl: stop bison from declaring yylex and yyerror itself.
+
+glibc 2.31 regenerates intl/plural.c from plural.y at build time, and bison
+3.8 then emits its own static prototypes for __gettextlex and __gettexterror,
+which clash with the ones plural.y provides:
+
+    intl/plural.c:69:25: error: static declaration of '__gettextlex'
+                         follows non-static declaration
+
+Backport of the upstream glibc fix (in 2.34 and later), which defines the two
+macros bison checks before writing those prototypes.
+
+--- a/intl/plural.y
++++ b/intl/plural.y
+@@ -40,6 +40,11 @@
+ # define __gettextparse PLURAL_PARSE
+ #endif
+ 
++/* Later we provide those prototypes.  Without these macros, bison may
++   generate its own prototypes with possible conflicts.  */
++#define YYLEX_IS_DECLARED
++#define YYERROR_IS_DECLARED
++
+ %}
+ %parse-param {struct parse_args *arg}
+ %lex-param {struct parse_args *arg}
