// Pulls in DEVELOPMENT_TEAM from a local, git-ignored override if present.
#include? "Local.xcconfig"

// Testnet flavor. Mirrors Android's netTestnet product flavor: distinct bundle
// id + display name so it installs side by side with mainnet.
WALLET_NET = testnet
PRODUCT_BUNDLE_IDENTIFIER = com.bisoncraft.caribou.testnet
CARIBOU_DISPLAY_NAME = Caribou testnet
