<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <!-- Launcher label, set per network by the xcconfig (mainnet/testnet/simnet),
         the iOS analog of Android's per-flavor manifest appName placeholder. -->
    <key>CFBundleDisplayName</key>
    <string>$(CARIBOU_DISPLAY_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- Build-time network ("mainnet"/"testnet"/"simnet"), set per-config by the
         network xcconfig's WALLET_NET. AppModel reads this and passes it to
         App.start, mirroring Android's BuildConfig.WALLET_NET. -->
    <key>WalletNet</key>
    <string>$(WALLET_NET)</string>

    <!-- Required for Face ID: iOS crashes any LocalAuthentication / biometric
         Keychain call if this usage string is absent. Shown in the Face ID
         consent prompt. Backs the session-lock re-auth (biometrics.md); Touch ID
         needs no separate key. -->
    <key>NSFaceIDUsageDescription</key>
    <string>Unlock Caribou with Face ID.</string>

    <!-- The appserver runs on loopback in-process and the WebView loads it over
         plaintext HTTP. Loopback never leaves the device; NSAllowsLocalNetworking
         permits cleartext to localhost/loopback only, without disabling ATS
         globally. The iOS analog of Android's network_security_config. Note the
         appserver's capability token, not network isolation, is what gates wallet
         operations. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- An empty UILaunchScreen gives a default launch storyboard, which also
         opts the app into full native screen resolution. -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Export compliance. Answering here stops App Store Connect from asking
         the encryption questionnaire on every single upload.

         Caribou plainly *uses* encryption (wallet key derivation and storage,
         TLS to chain backends, Tor). "NonExempt" is the narrower question: does
         it use encryption that is NOT covered by an EAR exemption. Caribou's
         source is published (Blue Oak, public repo), which is the basis for
         License Exception TSU, so the answer is no.

         That exception is conditional on the TSU notification being filed with
         BIS and the NSA (EAR 740.13(e)(3)) — the one-time email naming the
         public source URL. Do not leave this key at false without that filing
         on record. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- No ~ipad variant: TARGETED_DEVICE_FAMILY is "1" (see project.yml).
         Add one back alongside the "1,2" restore, not before. -->
</dict>
</plist>
