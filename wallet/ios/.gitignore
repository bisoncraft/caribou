# Generated Xcode project (regenerate from project.yml with: xcodegen generate).
BossWallet.xcodeproj/

# gomobile-bound framework (build it with ./bind.sh).
Frameworks/Mobile.xcframework/

# Native monero framework for XMR builds (assembled by BOSSW_XMR=1 ./bind.sh).
Frameworks/Monero.xcframework/

# Local signing override (developer-specific DEVELOPMENT_TEAM).
BossWallet/Config/Local.xcconfig

# Xcode user state / build output.
xcuserdata/
*.xcuserstate
build/
DerivedData/
.DS_Store
