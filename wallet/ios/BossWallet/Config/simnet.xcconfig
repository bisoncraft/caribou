// Pulls in DEVELOPMENT_TEAM from a local, git-ignored override if present.
#include? "Local.xcconfig"

// Simnet flavor. Mirrors Android's netSimnet product flavor: distinct bundle id
// + display name so it installs side by side with mainnet.
WALLET_NET = simnet
PRODUCT_BUNDLE_IDENTIFIER = com.bisoncraft.bosswallet.simnet
BOSSW_DISPLAY_NAME = Boss Wallet simnet
