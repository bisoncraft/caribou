<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Hardened Runtime entitlements for the Developer ID (outside the App
	  Store) distribution. release/package-darwin.sh applies them with
	  rcodesign to Caribou.app and its nested Electron helper apps only.

	  V8 maps its JIT region with MAP_JIT, which the hardened runtime allows
	  only with allow-jit. This is the whole set Chromium itself ships for
	  its app, renderer and GPU processes, and what @electron/osx-sign
	  applies by default.

	  The Go `caribou` binary and libmonero_wallet2_api_c.dylib get the
	  hardened runtime with no entitlements. Library validation stays on
	  everywhere: every Mach-O in the bundle is signed by the same team, so
	  the wallet process can load the XMR dylib and nothing else foreign.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
