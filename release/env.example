# Credentials for the release scripts. Copy this file to release/.env/env.sh
# and fill it in. The whole release/.env/ directory is gitignored and is
# mounted read-only at /secrets inside the builder image, so the file paths
# below are relative to release/.env/. Plain KEY=value lines only: the file is
# sourced by bash.

# ---- Apple: package-darwin.sh -------------------------------------------
APPLE_TEAM_ID=

# Developer ID Application identity. Either a PEM private key + certificate
# (a CSR made with openssl on Linux, uploaded to the developer portal) ...
APPLE_KEY_FILE=apple/developer-id.key
APPLE_CERT_FILE=apple/developer-id.crt
# ... or a PKCS#12 export from a Mac keychain. Set one pair, not both.
#APPLE_P12=apple/developer-id.p12
#APPLE_P12_PASSWORD=

# App Store Connect API key for notarization (App Store Connect > Users and
# Access > Integrations > Team Keys), encoded once into a single JSON file:
#
#   docker run --rm -v "$PWD/release/.env:/secrets" caribou-builder \
#     rcodesign encode-app-store-connect-api-key -o /secrets/apple/asc-key.json \
#     <issuer-id> <key-id> /secrets/apple/AuthKey_<key-id>.p8
ASC_KEY_JSON=apple/asc-key.json

# ---- Windows: package-windows.sh -----------------------------------------
# Azure Artifact Signing (formerly Trusted Signing; jsign still calls the
# backend TRUSTEDSIGNING). The service principal needs the "Artifact Signing
# Certificate Profile Signer" role on the account, profile or resource group.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Region endpoint of the Artifact Signing account, host only (eus, wus2, ...
# per the region table in Microsoft's quickstart).
ACS_ENDPOINT=eus.codesigning.azure.net
ACS_ACCOUNT=
ACS_PROFILE=

# For exercising the pipeline before Artifact Signing is available: a local
# PKCS#12 keystore with a self-signed code-signing certificate. Used only when
# the ACS_* variables above are empty.
#
#   openssl req -x509 -newkey rsa:3072 -days 365 -subj "/CN=Caribou test signing" \
#     -addext "extendedKeyUsage=codeSigning" -keyout /tmp/k.pem -out /tmp/c.pem -noenc
#   openssl pkcs12 -export -inkey /tmp/k.pem -in /tmp/c.pem -passout pass:test \
#     -out release/.env/windows/test-signing.pfx
#WINDOWS_PFX=windows/test-signing.pfx
#WINDOWS_PFX_PASSWORD=test

# ---- Release manifest: release.sh ----------------------------------------
# GPG key that signs SHA256SUMS. Empty means gpg's default key.
GPG_KEY_ID=
